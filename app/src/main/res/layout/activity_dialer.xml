<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CallGuard Phone" android:textSize="26sp" android:textStyle="bold"/>
<EditText android:id="@+id/number" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Phone number" android:inputType="phone" android:textSize="22sp"/>
<Button android:id="@+id/call" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Call"/>
</LinearLayout>
